# 数据库
DATABASE_URL="file:./dev.db"

# 生产环境（Vercel + Turso）—— 本地开发无需设置
TURSO_DB_URL="libsql://your-db.turso.io"
TURSO_AUTH_TOKEN=""

# Auth.js — 运行 `npx auth secret` 生成
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Admin 後台登入
ADMIN_USER=admin
ADMIN_PASS=

# ECPay 綠界金流
ECPAY_MERCHANT_ID=""
ECPAY_HASH_KEY=""
ECPAY_HASH_IV=""
ECPAY_STAGE=true

# 站点配置
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_NAME="高爾夫球具裝備商城"
